{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/components": ["./app/_components/index.js"],
      "@/config": ["./app/_config/index.js"],
      "@/data": ["./app/_data/index.js"],
      "@/fonts": ["./app/_fonts/index.js"],
      "@/hooks": ["./app/_hooks/index.js"],
      "@/layout": ["./app/_layout/index.js"],
      "@/lib": ["./app/_lib/index.js"],
      "@/providers": ["./app/_providers/index.jsx"],
      "@/utils": ["./app/_utils/index.js"],
      "@/*": ["./*"]
    },
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
